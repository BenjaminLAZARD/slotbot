# Copy to .env (gitignored) and fill in. Read by docker compose and by the API.

# Encrypts each profile's booking-site credentials in the database. Generate one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLOTBOT_SECRET_KEY=

# Your email, sent to OpenStreetMap's geocoder as a contact (their usage policy asks for one).
SLOTBOT_CONTACT_EMAIL=

# local = timers inside the API process (dev); cloudtasks = Google Cloud Tasks (prod, see deploy/gcp.md)
SLOTBOT_TRIGGERS=local

# Hour at which Madrid opens D-6 slots. Unverified: confirm on the live site, then adjust.
SLOTBOT_MADRID_OPENS_AT=00:00

# The Google service-account key goes in ./secrets/google-service-account.json (gitignored);
# docker compose mounts it and points SLOTBOT_GOOGLE_SERVICE_ACCOUNT at it.

# Email notifications (optional). Resend: sign up at https://resend.com with the address you want
# emails at, create an API key with "Sending access" (it can only send), paste it here.
# Without your own domain Resend only delivers to that account address. After editing: docker compose up -d api
SLOTBOT_RESEND_API_KEY=
# Alternative (not recommended: a Gmail app password also opens your mailbox):
# SLOTBOT_SMTP_USER=
# SLOTBOT_SMTP_PASSWORD=
